        "## 為了加上索引值的成功版本"
      ],
      "metadata": {
        "id": "TzPtCCftDDbz"
      }
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 886
        },
        "id": "a670bdf5",
        "outputId": "71fcae55-ad90-4a3f-c321-341dc13b6ac8"
      },
      "source": [
        "import os\n",
        "import requests\n",
        "import pandas as pd\n",
        "from geopy.distance import geodesic\n",
        "from geopy.geocoders import ArcGIS\n",
        "from google.colab import userdata\n",
        "from IPython.display import display, Markdown\n",
        "from langchain_groq import ChatGroq\n",
        "from langchain.agents import AgentExecutor, create_tool_calling_agent\n",
        "from langchain_core.tools import tool\n",
        "from langchain_core.prompts import ChatPromptTemplate\n",
        "\n",
        "# 1. 設定API Key\n",
        "os.environ[\"GROQ_API_KEY\"] = userdata.get('GROQ_API_KEY')\n",
        "\n",
        "# 2. 定義工具 (Tools)\n",
        "\n",
        "@tool\n",
        "def arcgis_geocoder(location: str) -> dict:\n",
        "    \"\"\"使用 ArcGIS 定位引擎獲取座標。\"\"\"\n",
        "    try:\n",
        "        geolocator = ArcGIS(timeout=10)\n",
        "        res = geolocator.geocode(location)\n",
        "        if res:\n",
        "            return {\"latitude\": res.latitude, \"longitude\": res.longitude}\n",
        "        return {\"status\": \"error\", \"message\": \"找不到地點\"}\n",
        "    except Exception as e:\n",
        "        return {\"status\": \"error\", \"message\": str(e)}\n",
        "\n",
        "@tool\n",
        "def get_nearby_youbike(latitude: float, longitude: float) -> str:\n",
        "    \"\"\"根據經緯度抓取 1 公里內的 YouBike 2.0 站點並格式化輸出。\"\"\"\n",
        "    url = \"https://apis.youbike.com.tw/json/station-yb2.json\"\n",
        "    headers = {\"User-Agent\": \"Mozilla/5.0\", \"Referer\": \"https://www.youbike.com.tw/\"}\n",
        "    try:\n",
        "        res = requests.get(url, headers=headers, timeout=15)\n",
        "        stations = res.json()\n",
        "\n",
        "        # --- 關鍵修正 1：處理桃園等縣市可能出現的字典結構 ---\n",
        "        if isinstance(stations, dict) and 'retVal' in stations:\n",
        "            stations = list(stations['retVal'].values())\n",
        "\n",
        "    except Exception as e:\n",
        "        return f\"Error: 無法取得 API 資料: {e}\"\n",
        "\n",
        "    nearby = []\n",
        "    center = (latitude, longitude)\n",
        "    for s in stations:\n",
        "        try:\n",
        "            s_lat, s_lng = float(s.get('lat', 0)), float(s.get('lng', 0))\n",
        "            dist_km = geodesic(center, (s_lat, s_lng)).km\n",
        "            if dist_km <= 1.0:\n",
        "                # --- 關鍵修正 2：欄位名稱相容性處理 ---\n",
        "                detail = s.get('available_spaces_detail', {})\n",
        "                # 若 detail 為空（如桃園），則嘗試從第一層 sbi/bemp 抓取\n",
        "                yb2 = int(detail.get('yb2', s.get('sbi', 0)))\n",
        "                eyb = int(detail.get('eyb', 0))\n",
        "                empty = int(s.get('empty_spaces', s.get('bemp', 0)))\n",
        "\n",
        "                nearby.append({\n",
        "                    \"區域\": s.get('district_tw', s.get('sarea', '未知')),\n",
        "                    \"站點編號\": s.get('station_no', s.get('sno', '')),\n",
        "                    \"站點名稱\": s.get('name_tw', s.get('sna', '')).replace('YouBike2.0_', ''),\n",
        "                    \"YouBike 2.0 數量\": yb2,\n",
        "                    \"YouBike E2.0 數量\": eyb,\n",
        "                    \"可停空位\": empty,\n",
        "                    \"更新時間\": s.get('updated_at', s.get('mday', '')),\n",
        "                    \"距離\": round(dist_km, 3)\n",
        "                })\n",
        "        except:\n",
        "            continue\n",
        "\n",
        "    nearby.sort(key=lambda x: x[\"距離\"])\n",
        "    if not nearby:\n",
        "        return \"1.0 公里內找不到站點。\"\n",
        "\n",
        "    df = pd.DataFrame(nearby[:10])\n",
        "    df.reset_index(drop=True, inplace=True)\n",
        "    df.insert(0, ' ', df.index)\n",
        "    return df.to_markdown(index=False, tablefmt=\"pipe\")\n",
        "\n",
        "# 3. 建立 Agent (模型改用 llama-3.3-70b 穩定性更高)\n",
        "llm = ChatGroq(model=\"llama-3.3-70b-versatile\", temperature=0)\n",
        "tools = [arcgis_geocoder, get_nearby_youbike]\n",
        "\n",
        "prompt = ChatPromptTemplate.from_messages([\n",
        "    (\"system\", \"\"\"你是一個 YouBike 數據助理。\n",
        "    1. 使用 arcgis_geocoder 取得目標地的經緯度。\n",
        "    2. 使用返回的座標呼叫 get_nearby_youbike。\n",
        "    3. 輸出規範：直接顯示 get_nearby_youbike 回傳的 Markdown 表格，不要解釋文字。\"\"\"),\n",
        "    (\"human\", \"{input}\"),\n",
        "    (\"placeholder\", \"{agent_scratchpad}\"),\n",
        "])\n",
        "\n",
        "agent = create_tool_calling_agent(llm, tools, prompt)\n",
        "controller_agent = AgentExecutor(agent=agent, tools=tools, verbose=False)\n",
        "\n",
        "# 4. 執行函式\n",
        "def run_test(query):\n",
        "    clean_title = query.replace('附近的YouBike','').replace('附近的','')\n",
        "    display(Markdown(f\"### ═══ {clean_title} 方圓 1.0 公里內 YouBike 清單 ═══\"))\n",
        "    try:\n",
        "        response = controller_agent.invoke({\"input\": query})\n",
        "        display(Markdown(response['output']))\n",
        "    except Exception as e:\n",
        "        print(f\"錯誤: {e}\")\n",
        "\n",
        "# --- 測試執行 ---\n",
        "run_test(\"元智大學\")\n",
        "run_test(\"台北101\")"
      ],
